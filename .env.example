# Supabase project URL (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key -- SECRET, server-only, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# Domain suffix used to build synthetic emails for username/password login
# e.g. username "jsilva" -> auth email "jsilva@registro-inbound.local"
AUTH_EMAIL_DOMAIN=registro-inbound.local
